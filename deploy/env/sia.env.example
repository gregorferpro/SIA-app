# Plantilla sin secretos. El archivo real vive solo en sia-app:
# /etc/sia/sia.env (root:sia, modo 640). No se copia al repositorio.
# DJANGO_SECRET_KEY se genera en el servidor.
# DJANGO_DB_PASSWORD se escribe ahí cuando PostgreSQL la pide, y no queda en git.
#
# El navegador entra directo a sia-nginx, que está en modo puente en el Wi-Fi.

DJANGO_DEBUG=False
# sia-nginx toma su IP del Wi-Fi por DHCP y cambia con la red. Gunicorn solo
# acepta conexiones de 30.30.30.1 (UFW), así que en el laboratorio se acepta
# cualquier Host en lugar de reescribir la lista con cada IP nueva.
DJANGO_ALLOWED_HOSTS=*
DJANGO_CSRF_TRUSTED_ORIGINS=https://127.0.0.1,https://localhost,https://192.168.26.112,https://sia.192.168.26.112.nip.io
DJANGO_BEHIND_PROXY=True
DJANGO_USE_HTTPS=True

# Ollama corre en el equipo anfitrión (Windows), no en sia-app. La IP es la
# del anfitrión en el Wi-Fi y cambia con la red, igual que la de sia-nginx.
OLLAMA_URL=http://192.168.10.116:11434
OLLAMA_MODELO=sigta-ai
OLLAMA_TIMEOUT=60

DJANGO_DB_ENGINE=postgresql
DJANGO_DB_NAME=sia
DJANGO_DB_USER=sia
DJANGO_DB_HOST=127.0.0.1
DJANGO_DB_PORT=5432
